{
  "listen": "127.0.0.1",
  "port": 8787,
  "features": {
    "upstream_url": "",
    "api_key_env": "FEATURE_UPSTREAM_KEY",
    "header": "Authorization",
    "header_prefix": "Bearer ",
    "params": {"network": "network", "token": "token", "pool": "pool"},
    "fixed_params": {},
    "fields": {
      "network": "network", "token": "token", "pool": "pool", "asof": "asof",
      "source": "source", "features.can_sell": "features.can_sell",
      "features.mint_revoked": "features.mint_revoked", "features.freeze_revoked": "features.freeze_revoked",
