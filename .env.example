# No private wallet keys are used anywhere in this project.
# CEX live public data works without these. Optional: query your actual commission.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Create a bot via @BotFather and send it /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Needed only for Solana DEX quote-based paper execution.
JUPITER_API_KEY=
# Optional authenticated catalog / research dataset / on-chain feature service.
DATA_API_KEY=
FEATURE_API_KEY=
WALLET_DATA_API_KEY=
WALLET_ACTIVITY_API_KEY=
DEX_QUOTE_API_KEY=
# The only key the adapters need. Read-only history; it cannot sign or send.
HELIUS_API_KEY=
# Shared secret for the webhook receiver, if you run one. Any long random string.
WALLET_WEBHOOK_SECRET=
# Candidate shortlist providers. Each is optional; a source whose key is
# unset is skipped, not fatal. See shortlist.sources in config.yaml.
DUNE_API_KEY=
BIRDEYE_API_KEY=
SOLSCAN_API_KEY=
# Optional supported-chain RPC, for diagnostics; not a substitute for indexed data.
CHAIN_RPC_URL=
